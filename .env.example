# 数据库连接（容器 compose 默认值）
DATABASE_URL=postgresql+psycopg://pilot:pilot@db:5432/pilot_schedule
# 本地无 Postgres 时可改用 SQLite：
# DATABASE_URL=sqlite+pysqlite:///./pilot_schedule.db

# 虚构站钟基准日（不带时区）
PLAN_BASE_DATE=2026-09-24
PLAN_HORIZON_MINUTES=2880

# 上一任务结束后的离船/转场与登船接送时长（分钟）
PILOT_DISEMBARK_MINUTES=25
PILOT_EMBARK_MINUTES=20
PILOT_TRANSFER_MINUTES=10

# 潮汐离线采样间隔（分钟）与 CP-SAT 确定性参数
TIDE_SAMPLE_MINUTES=10
SOLVER_SEED=42
SOLVER_TIME_LIMIT_SECONDS=15
